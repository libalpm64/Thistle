    # tcId=518 result=valid flags=[EdgeCasePrivateKey] comment='special case private key'
    var private_518 = b32(0xb8, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0x6a)
    var public_518  = b32(0xbe, 0x3b, 0x3e, 0xde, 0xff, 0xaf, 0x83, 0xc5, 0x4a, 0xe5, 0x26, 0x37, 0x9b, 0x23, 0xdd, 0x79, 0xf1, 0xcb, 0x41, 0x44, 0x6e, 0x36, 0x87, 0xfe, 0xf3, 0x47, 0xeb, 0x9b, 0x5f, 0x0d, 0xc3, 0x08)
    var shared_518  = b32(0xe3, 0xc6, 0x49, 0xbe, 0xae, 0x7c, 0xc4, 0xa0, 0x69, 0x8d, 0x51, 0x9a, 0x0a, 0x61, 0x93, 0x2e, 0xe5, 0x49, 0x3c, 0xbb, 0x59, 0x0d, 0xbe, 0x14, 0xdb, 0x02, 0x74, 0xcc, 0x86, 0x11, 0xf9, 0x14)
    var got_518 = x25519(private_518, public_518)
    total += 1
    if cmp32(got_518, shared_518):
        passed += 1
    else:
        failed += 1; print("FAIL tcId=518 (valid) 'special case private key'")

    print("Wycheproof x25519:", passed, "passed,", failed, "failed out of", total, "tests")
    if failed == 0: print("ALL PASS")
    else: print("FAILURES:", failed)
